{
  "name": "dinolearn-web",
  "private": true,
  "version": "0.26.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "voice-packs": "node scripts/voice-packs.mjs",
    "dev": "npm run icons && npm run piper && vite --host",
    "build": "npm run icons && npm run piper && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "piper": "node scripts/vendor-piper.mjs",
    "android": "npm run build && node scripts/app-assets.mjs && npx cap sync android",
    "ios": "npm run build && node scripts/app-assets.mjs && npx cap sync ios",
    "play:listings": "python3 fastlane/listings.py && NODE_USE_ENV_PROXY=1 node --no-warnings scripts/play-listings.mjs",
    "play:release": "python3 fastlane/changelogs.py && NODE_USE_ENV_PROXY=1 node --no-warnings scripts/play-release.mjs",
    "android:aab": "./scripts/android-aab.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/playwrite-fr-moderne": "^5.3.0",
    "easy-speech": "^2.4.0",
    "jspdf": "^4.2.1",
    "phaser": "^3.90.0",
    "three": "^0.172.0",
    "vosk-browser": "^0.0.8",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@iconify-json/circle-flags": "^1.2.12",
    "@iconify-json/noto": "^1.2.10",
    "@iconify-json/openmoji": "^1.2.29",
    "@iconify-json/withicons-plush": "^1.2.0",
    "@iconify/utils": "^3.1.7",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@types/node": "^22.20.5",
    "@types/three": "^0.172.0",
    "onnxruntime-web": "^1.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
